",
  "angular/cmn-sprite.ts": "import { DOCUMENT } from '@angular/common';
import { Inject, Injectable, InjectionToken, Optional, Provider } from '@angular/core';

export interface CmnSpriteConfig {
  /** where the sprite file is served, e.g. '/assets/cmn-sprite.svg' */
  url: string;
  /**
   * false (default): reference the file with <use href="url#id"> (same origin only).
   * true: fetch it once and insert it into the page, so icons use <use href="#id"> (works cross-origin with CORS, and in older browsers).
   */
  inline?: boolean;
}

export const CMN_SPRITE = new InjectionToken<CmnSpriteConfig>('cmn sprite');

/** Sprite strategy: providers: [provideCmnSprite({ url: '/assets/cmn-sprite.svg', inline: true })] */
export function provideCmnSprite(config: CmnSpriteConfig): Provider {
  return { provide: CMN_SPRITE, useValue: config };
}

@Injectable({ providedIn: 'root' })
export class CmnSpriteLoader {
  private started = false;
  readonly config: CmnSpriteConfig | null;

  constructor(@Optional() @Inject(CMN_SPRITE) config: CmnSpriteConfig | null, @Inject(DOCUMENT) private readonly doc: Document) {
    this.config = config;
  }

  /** href for an icon symbol */
  href(name: string): string {
    const id = 'cmn-' + name;
    return this.config && !this.config.inline ? this.config.url + '#' + id : '#' + id;
  }

  /** inline mode: fetch the sprite once */
  ensure(): void {
    if (this.started || !this.config?.inline) return;
    this.started = true;
    fetch(this.config.url)
      .then((r) => (r.ok ? r.text() : Promise.reject(new Error('sprite ' + r.status))))
      .then((svg) => {
        const holder = this.doc.createElement('div');
        holder.setAttribute('aria-hidden', 'true');
        holder.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden';
        holder.innerHTML = svg;
        this.doc.body.prepend(holder);
      })
      .catch(() => { this.started = false; });
  }
}
",
  "angular/icon-data.ts": "// Generated by Icon Library Toolkit — 2026-01-01. Do not edit by hand.
export interface CmnIconData {
  /** icon name, the key used by \`name="…"\` */
  name: string;
  viewBox: string;
  width: number;
  height: number;
  kind: 'filled' | 'stroked' | 'multicolor' | 'mixed';
  /** category path from Figma (name path, section, frame or page), '' when none */
  category: string;
  /** inner SVG markup (themeable through --cmn-icon-* CSS variables) */
  body: string;
}

export type CmnIconName = never;

/** Renamed icons: the old name still works for one major version and resolves to the new one. */
export const CMN_DEPRECATED = {} as const;
export type CmnIconDeprecatedName = keyof typeof CMN_DEPRECATED;

/** icon name → category chunk (see loaders.ts) */
export const CMN_CATEGORY_OF: Readonly<Record<string, string>> = {};

/** Stroke policy chosen in the plugin: 'constant' | 'scale' | 'table' (px weight by rendered size) */
export const CMN_STROKE: { policy: 'constant' | 'scale' | 'table'; table: readonly (readonly [number, number])[] } = { policy: 'constant', table: [[16,1.5],[24,2],[32,2],[48,2.5],[64,3]] };

/** Stroke weight for a rendered size (px), or null when the policy has no size-dependent weight. */
export function cmnStrokeFor(size: number | string | undefined): number | null {
  if (CMN_STROKE.policy !== 'table' || size === undefined || size === '') return null;
  const px = typeof size === 'number' ? size : parseFloat(size);
