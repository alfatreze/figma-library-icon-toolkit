  "angular/cmn-icon-registry.ts": "import { inject, Injectable, InjectionToken, Provider, signal } from '@angular/core';
import { CMN_CATEGORY_OF, CMN_DEPRECATED, CmnIconData } from './icon-data';
import { CMN_LOADERS } from './loaders';

type IconInput = CmnIconData | readonly CmnIconData[];

export const CMN_ICONS_TOKEN = new InjectionToken<readonly (readonly IconInput[])[]>('cmn icons');

/**
 * Register icons up front (synchronous, tree-shakable):
 *   providers: [provideCmnIcons(cmnHome, cmnSearch)]
 * Icons you do not register are still found by name: their category is loaded on first use as a lazy chunk.
 */
export function provideCmnIcons(...icons: IconInput[]): Provider {
  return { provide: CMN_ICONS_TOKEN, multi: true, useValue: icons };
}

@Injectable({ providedIn: 'root' })
export class CmnIconRegistry {
  private readonly store = signal<ReadonlyMap<string, CmnIconData>>(new Map());
  private readonly requested = new Set<string>();

  constructor() {
    const given = inject(CMN_ICONS_TOKEN, { optional: true }) ?? [];
    for (const group of given) for (const item of group) this.add(...(Array.isArray(item) ? item : [item as CmnIconData]));
  }

  add(...icons: CmnIconData[]): void {
    if (!icons.length) return;
    this.store.update((m) => {
      const next = new Map(m);
      for (const i of icons) next.set(i.name, i);
      return next;
    });
  }

  /** Reads a signal: call it inside computed() or a template so the view updates when a lazy category arrives. */
  get(requested: string): CmnIconData | undefined {
    const name = (CMN_DEPRECATED as Record<string, string>)[requested] ?? requested;
    const hit = this.store().get(name);
    if (!hit) this.load(name);
    return hit;
  }

  /** Warm categories ahead of use, e.g. preload('arrows'). */
  async preload(...categories: string[]): Promise<void> {
    await Promise.all(categories.map((c) => this.loadCategory(c)));
  }

  private load(name: string): void {
    const category = CMN_CATEGORY_OF[name];
    if (category !== undefined) void this.loadCategory(category);
  }

  private async loadCategory(category: string): Promise<void> {
    const loader = CMN_LOADERS[category];
    if (!loader || this.requested.has(category)) return;
    this.requested.add(category);
    try {
      this.add(...(await loader()));
    } catch {
      this.requested.delete(category); // allow a retry (network hiccup)
    }
  }
}
",
  "angular/cmn-icon.component.ts": "import { ChangeDetectionStrategy, Component, computed, inject, input } from '@angular/core';
import { DomSanitizer } from '@angular/platform-browser';
import { CmnIconData, CmnIconDeprecatedName, CmnIconName, cmnStrokeFor, cmnSvg } from './icon-data';
import { CmnIconRegistry } from './cmn-icon-registry';

/**
 * <cmn-icon name="…" />        looked up by name (registered icons, otherwise its category loads lazily)
 * <cmn-icon [icon]="cmnHome" />  imported directly: synchronous and tree-shakable
 * (Angular 17.1+, standalone, signals)
 * Customise via inputs or CSS variables: --cmn-icon-size, --cmn-icon-color, --cmn-icon-color-2, --cmn-icon-stroke-width.
 * Pass [label] for meaningful icons; without it the icon is decorative (aria-hidden).
 */
@Component({
  selector: 'cmn-icon',
  standalone: true,
  changeDetection: ChangeDetectionStrategy.OnPush,
  host: {
    '[attr.role]': 'label() ? "img" : null',
    '[attr.aria-label]': 'label() || null',
    '[attr.aria-hidden]': 'label() ? null : "true"',
    '[style.--cmn-icon-size]': 'sizeCss()',
    '[style.--cmn-icon-color]': 'color() || null',
    '[style.--cmn-icon-stroke-width]': 'strokeCss()'
  },
  template: '<span class="cmn-icon__inner" [innerHTML]="html()"></span>',
  styles: [
    ':host{display:inline-block;width:var(--cmn-icon-size,1em);height:var(--cmn-icon-size,1em);flex:none;line-height:0;vertical-align:-0.125em}',
    '.cmn-icon__inner{display:block;width:100%;height:100%}'
  ]
})
export class CmnIcon {
  private readonly sanitizer = inject(DomSanitizer);
  private readonly registry = inject(CmnIconRegistry);

  readonly name = input<CmnIconName | CmnIconDeprecatedName | undefined>(undefined);
  /** icon object imported from './icons' (wins over name) */
  readonly icon = input<CmnIconData | undefined>(undefined);
  readonly size = input<string | number | undefined>(undefined);
  readonly color = input<string | undefined>(undefined);
  readonly strokeWidth = input<number | string | undefined>(undefined);
  readonly label = input<string | undefined>(undefined);

  protected readonly sizeCss = computed(() => {
    const s = this.size();
    return s === undefined || s === '' ? null : typeof s === 'number' ? s + 'px' : s;
  });

  /** explicit strokeWidth wins; otherwise the plugin's weight-by-size table (when that policy is used) */
  protected readonly strokeCss = computed(() => this.strokeWidth() ?? cmnStrokeFor(this.size()));

  protected readonly html = computed(() => {
    const name = this.name();
    const data = this.icon() ?? (name ? this.registry.get(name) : undefined);
    if (!data) return '';
    // Trusted, generated markup (not user input).
    return this.sanitizer.bypassSecurityTrustHtml(cmnSvg(data));
  });
}
",
