  "angular-classic/cmn-icon-registry.ts": "import { Inject, Injectable, InjectionToken, Optional, Provider } from '@angular/core';
import { Subject } from 'rxjs';
import { CMN_CATEGORY_OF, CMN_DEPRECATED, CmnIconData } from './icon-data';
import { CMN_LOADERS } from './loaders';

type IconInput = CmnIconData | readonly CmnIconData[];

export const CMN_ICONS_TOKEN = new InjectionToken<readonly (readonly IconInput[])[]>('cmn icons');

/**
 * Register icons up front (synchronous, tree-shakable):
 *   providers: [provideCmnIcons(cmnHome, cmnSearch)]
 * Icons you do not register are still found by name: their category is loaded on first use as a lazy chunk.
 */
export function provideCmnIcons(...icons: IconInput[]): Provider {
  return { provide: CMN_ICONS_TOKEN, multi: true, useValue: icons };
}

@Injectable({ providedIn: 'root' })
export class CmnIconRegistry {
  private readonly store = new Map<string, CmnIconData>();
  private readonly requested = new Set<string>();
  /** emits when icons were added (a lazy category arrived) */
  readonly changes = new Subject<void>();

  constructor(@Optional() @Inject(CMN_ICONS_TOKEN) given: readonly (readonly IconInput[])[] | null) {
    for (const group of given ?? []) for (const item of group) this.add(...(Array.isArray(item) ? item : [item as CmnIconData]));
  }

  add(...icons: CmnIconData[]): void {
    if (!icons.length) return;
    for (const i of icons) this.store.set(i.name, i);
    this.changes.next();
  }

  get(requested: string): CmnIconData | undefined {
    const name = (CMN_DEPRECATED as Record<string, string>)[requested] ?? requested;
    const hit = this.store.get(name);
    if (!hit) this.load(name);
    return hit;
  }

  /** Warm categories ahead of use, e.g. preload('arrows'). */
  preload(...categories: string[]): Promise<void[]> {
    return Promise.all(categories.map((c) => this.loadCategory(c)));
  }

  private load(name: string): void {
    const category = CMN_CATEGORY_OF[name];
    if (category !== undefined) void this.loadCategory(category);
  }

  private loadCategory(category: string): Promise<void> {
    const loader = CMN_LOADERS[category];
    if (!loader || this.requested.has(category)) return Promise.resolve();
    this.requested.add(category);
    return loader().then(
      (icons) => this.add(...icons),
      () => { this.requested.delete(category); }
    );
  }
}
