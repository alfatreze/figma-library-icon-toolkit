{
  "svelte/acme-icon-registry.ts": "import { writable } from 'svelte/store';
import { ACME_CATEGORY_OF, ACME_DEPRECATED } from './icon-data';
import type { AcmeIconData } from './icon-data';
import { ACME_LOADERS } from './loaders';

// A store: a component that subscribed ($acmeIcons) updates when a category chunk arrives.
const store = writable<ReadonlyMap<string, AcmeIconData>>(new Map());
export const acmeIcons = { subscribe: store.subscribe };
const requested = new Set<string>();

/**
 * Register icons up front (synchronous, tree-shakable): registerAcmeIcons(acmeHome, acmeSearch).
 * Icons you do not register are still found by name: their category loads on first use as a lazy chunk.
 */
export function registerAcmeIcons(...icons: (AcmeIconData | readonly AcmeIconData[])[]): void {
  store.update((current) => {
    const next = new Map(current);
    for (const item of icons) for (const i of Array.isArray(item) ? item : [item as AcmeIconData]) next.set(i.name, i);
    return next;
  });
}

function load(category: string): Promise<void> {
  const loader = ACME_LOADERS[category];
  if (!loader || requested.has(category)) return Promise.resolve();
  requested.add(category);
  return loader().then(
    (icons) => registerAcmeIcons(icons),
    () => { requested.delete(category); } // allow a retry
  );
}

/** Warm categories ahead of use, e.g. preloadAcmeIcons('arrows'). */
export function preloadAcmeIcons(...categories: string[]): Promise<void[]> {
  return Promise.all(categories.map(load));
}

/** Looks an icon up by name in the registered icons; triggers its category chunk when missing (the store then updates). */
export function findAcmeIcon(requestedName: string | undefined, icons: ReadonlyMap<string, AcmeIconData>): AcmeIconData | undefined {
  if (!requestedName) return undefined;
  const name = (ACME_DEPRECATED as Record<string, string>)[requestedName] ?? requestedName;
  const hit = icons.get(name);
  if (!hit) {
    const category = ACME_CATEGORY_OF[name];
    if (category !== undefined) void load(category);
  }
  return hit;
}
