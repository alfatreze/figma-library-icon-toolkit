export declare const ACME_ICONS: Record<AcmeIconName, AcmeIconData>;
export declare const ACME_DEPRECATED: Record<string, string>;
export declare class AcmeIconElement extends HTMLElement {
  static register(icons: Record<string, AcmeIconData>): void;
  name: string | null;
}
declare global {
  interface HTMLElementTagNameMap { 'acme-icon': AcmeIconElement }
