  "bars": {"viewBox":"0 0 24 24","body":"<path fill-rule=\\"evenodd\\" clip-rule=\\"evenodd\\" d=\\"M12 8C11.45 8 11 8.45 11 9V15C11 15.55 11.45 16 12 16C12.55 16 13 15.55 13 15V9C13 8.45 12.55 8 12 8Z\\" fill=\\"#1F1D1D\\"/><path fill-rule=\\"evenodd\\" clip-rule=\\"evenodd\\" d=\\"M16 6C15.45 6 15 6.45 15 7V17C15 17.55 15.45 18 16 18C16.55 18 17 17.55 17 17V7C17 6.45 16.55 6 16 6Z\\" fill=\\"#1F1D1D\\"/><path fill-rule=\\"evenodd\\" clip-rule=\\"evenodd\\" d=\\"M8 6C7.45 6 7 6.45 7 7V17C7 17.55 7.45 18 8 18C8.55 18 9 17.55 9 17V7C9 6.45 8.55 6 8 6Z\\" fill=\\"#1F1D1D\\"/><path fill-rule=\\"evenodd\\" clip-rule=\\"evenodd\\" d=\\"M20 10C19.45 10 19 10.45 19 11V13C19 13.55 19.45 14 20 14C20.55 14 21 13.55 21 13V11C21 10.45 20.55 10 20 10Z\\" fill=\\"#1F1D1D\\"/><path fill-rule=\\"evenodd\\" clip-rule=\\"evenodd\\" d=\\"M4 10C3.45 10 3 10.45 3 11V13C3 13.55 3.45 14 4 14C4.55 14 5 13.55 5 13V11C5 10.45 4.55 10 4 10Z\\" fill=\\"#1F1D1D\\"/>","category":"arrows"}
};

// intentional duplicates share one drawing
const ALIASES = {};
for (const [alias, owner] of Object.entries(ALIASES)) ACME_ICONS[alias] = ACME_ICONS[owner];

export const ACME_DEPRECATED = {};
const STROKE_POLICY = 'constant';
const STROKE_TABLE = [];

const strokeFor = (size) => {
  if (STROKE_POLICY !== 'table' || !size) return null;
  const px = parseFloat(size);
  if (!isFinite(px) || /em|%/.test(size)) return null;
  let w = null;
  for (const [s, weight] of STROKE_TABLE) { if (w === null || s <= px) w = weight; }
  return w;
};

const STYLE = ':host{display:inline-block;width:var(--acme-icon-size,1em);height:var(--acme-icon-size,1em);flex:none;line-height:0;vertical-align:-0.125em}svg{display:block;width:100%;height:100%}';

export class AcmeIconElement extends HTMLElement {
  static get observedAttributes() { return ['name', 'size', 'color', 'stroke-width', 'label']; }

  constructor() {
    super();
    this.attachShadow({ mode: 'open' });
  }

  connectedCallback() { this.#render(); }
  attributeChangedCallback() { if (this.isConnected) this.#render(); }

  /** add or replace icons at runtime: { 'my-icon': { viewBox: '0 0 24 24', body: '<path d="…"/>' } } */
  static register(icons) { Object.assign(ACME_ICONS, icons); }

  #render() {
    const requested = this.getAttribute('name') || '';
    const data = ACME_ICONS[ACME_DEPRECATED[requested] || requested];
    const size = this.getAttribute('size');
    const color = this.getAttribute('color');
    const label = this.getAttribute('label');
    const weight = this.getAttribute('stroke-width') ?? strokeFor(size);
    if (size) this.style.setProperty('--acme-icon-size', /^[0-9.]+$/.test(size) ? size + 'px' : size); else this.style.removeProperty('--acme-icon-size');
    if (color) this.style.setProperty('--acme-icon-color', color); else this.style.removeProperty('--acme-icon-color');
    if (weight !== null && weight !== undefined && weight !== '') this.style.setProperty('--acme-icon-stroke-width', String(weight)); else this.style.removeProperty('--acme-icon-stroke-width');
    if (label) { this.setAttribute('role', 'img'); this.setAttribute('aria-label', label); this.removeAttribute('aria-hidden'); }
    else { this.removeAttribute('role'); this.removeAttribute('aria-label'); this.setAttribute('aria-hidden', 'true'); }
    // Trusted, generated markup (not user input).
    this.shadowRoot.innerHTML = '<style>' + STYLE + '</style>' + (data
      ? '<svg viewBox="' + data.viewBox + '" fill="none" focusable="false" aria-hidden="true">' + data.body + '</svg>'
      : '');
  }
}

if (!customElements.get('acme-icon')) customElements.define('acme-icon', AcmeIconElement);
",
}
`;

