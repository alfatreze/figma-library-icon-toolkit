export type CmnIconName = "home" | "pie" | "bars";

/** Renamed icons: the old name still works for one major version and resolves to the new one. */
export const CMN_DEPRECATED = {} as const;
export type CmnIconDeprecatedName = keyof typeof CMN_DEPRECATED;

/** icon name → category chunk (see loaders.ts) */
export const CMN_CATEGORY_OF: Readonly<Record<string, string>> = {"home":"nav","pie":"nav","bars":"arrows"};

/** Stroke policy chosen in the plugin: 'constant' | 'scale' | 'table' (px weight by rendered size) */
export const CMN_STROKE: { policy: 'constant' | 'scale' | 'table'; table: readonly (readonly [number, number])[] } = { policy: 'constant', table: [[16,1.5],[24,2],[32,2],[48,2.5],[64,3]] };

