  "vue/cmn-icon-registry.ts": "import { shallowReactive } from 'vue';
import { CMN_CATEGORY_OF, CMN_DEPRECATED } from './icon-data';
import type { CmnIconData } from './icon-data';
import { CMN_LOADERS } from './loaders';

// A reactive map: a component that looked an icon up re-renders when its category chunk arrives.
const store = shallowReactive(new Map<string, CmnIconData>());
const requested = new Set<string>();

/**
 * Register icons up front (synchronous, tree-shakable): registerCmnIcons(cmnHome, cmnSearch).
 * Icons you do not register are still found by name: their category loads on first use as a lazy chunk.
 */
export function registerCmnIcons(...icons: (CmnIconData | readonly CmnIconData[])[]): void {
  for (const item of icons) for (const i of Array.isArray(item) ? item : [item as CmnIconData]) store.set(i.name, i);
}

function load(category: string): Promise<void> {
  const loader = CMN_LOADERS[category];
  if (!loader || requested.has(category)) return Promise.resolve();
  requested.add(category);
  return loader().then(
    (icons) => registerCmnIcons(icons),
    () => { requested.delete(category); } // allow a retry
  );
}

/** Warm categories ahead of use, e.g. preloadCmnIcons('arrows'). */
export function preloadCmnIcons(...categories: string[]): Promise<void[]> {
  return Promise.all(categories.map(load));
}

/** Looks an icon up by name; triggers its category chunk when missing. Call it while rendering: the lookup is reactive. */
export function useCmnIcon(requestedName: string | undefined): CmnIconData | undefined {
  if (!requestedName) return undefined;
  const name = (CMN_DEPRECATED as Record<string, string>)[requestedName] ?? requestedName;
  const hit = store.get(name);
  if (!hit) {
    const category = CMN_CATEGORY_OF[name];
    if (category !== undefined) void load(category);
  }
  return hit;
}
",
  "vue/cmn-icon.ts": "import { defineComponent, h } from 'vue';
import type { PropType } from 'vue';
import { cmnStrokeFor, cmnSvg } from './icon-data';
import type { CmnIconData, CmnIconDeprecatedName, CmnIconName } from './icon-data';
import { useCmnIcon } from './cmn-icon-registry';

/**
 * <CmnIcon :icon="cmnHome" :size="24" />   imported directly: synchronous and tree-shakable
 * <CmnIcon name="home" :size="24" />        by name: registered icons render at once, others load their category lazily
 * Style with CSS variables too: --cmn-icon-size, --cmn-icon-color, --cmn-icon-color-2, --cmn-icon-stroke-width.
 */
export const CmnIcon = defineComponent({
  name: 'CmnIcon',
  props: {
    /** typed icon name (renamed icons keep working under their old name for one major version) */
    name: { type: String as PropType<CmnIconName | CmnIconDeprecatedName>, default: undefined },
    /** icon object imported from './icons' (synchronous, tree-shakable; wins over name) */
    icon: { type: Object as PropType<CmnIconData>, default: undefined },
    /** number = px, or any CSS length */
    size: { type: [Number, String] as PropType<number | string>, default: undefined },
    /** primary colour (any CSS colour); default currentColor */
    color: { type: String, default: undefined },
    /** line icons only (px) */
    strokeWidth: { type: [Number, String] as PropType<number | string>, default: undefined },
    /** accessible name; omit for decorative icons */
    label: { type: String, default: undefined },
  },
  setup(props) {
    return () => {
      const data = props.icon ?? useCmnIcon(props.name);
      if (!data) return null;

      const vars: Record<string, string | number> = {};
      if (props.size !== undefined && props.size !== '') vars['--cmn-icon-size'] = typeof props.size === 'number' ? props.size + 'px' : props.size;
      if (props.color) vars['--cmn-icon-color'] = props.color;
      const weight = props.strokeWidth ?? cmnStrokeFor(props.size);
      if (weight !== null && weight !== undefined) vars['--cmn-icon-stroke-width'] = weight;

      return h('span', {
        role: props.label ? 'img' : undefined,
        'aria-label': props.label,
        'aria-hidden': props.label ? undefined : 'true',
        style: {
          display: 'inline-block',
          width: 'var(--cmn-icon-size, 1em)',
          height: 'var(--cmn-icon-size, 1em)',
          flex: 'none',
          lineHeight: 0,
          verticalAlign: '-0.125em',
          ...vars,
        },
        // Trusted, generated markup (not user input).
        innerHTML: cmnSvg(data),
      });
    };
  },
});
",
  "vue/icon-data.ts": "// Generated by Icon Library Toolkit — 2026-01-01. Do not edit by hand.
export interface CmnIconData {
  /** icon name, the key used by \`name="…"\` */
  name: string;
  viewBox: string;
  width: number;
  height: number;
  kind: 'filled' | 'stroked' | 'multicolor' | 'mixed';
  /** category path from Figma (name path, section, frame or page), '' when none */
  category: string;
  /** inner SVG markup (themeable through --cmn-icon-* CSS variables) */
  body: string;
}

export type CmnIconName = "home" | "pie" | "bars";

/** Renamed icons: the old name still works for one major version and resolves to the new one. */
export const CMN_DEPRECATED = {} as const;
export type CmnIconDeprecatedName = keyof typeof CMN_DEPRECATED;

/** icon name → category chunk (see loaders.ts) */
export const CMN_CATEGORY_OF: Readonly<Record<string, string>> = {"home":"nav","pie":"nav","bars":"arrows"};

/** Stroke policy chosen in the plugin: 'constant' | 'scale' | 'table' (px weight by rendered size) */
export const CMN_STROKE: { policy: 'constant' | 'scale' | 'table'; table: readonly (readonly [number, number])[] } = { policy: 'table', table: [[16,1.5],[24,2],[32,2],[48,2.5],[64,3]] };

/** Stroke weight for a rendered size (px), or null when the policy has no size-dependent weight. */
export function cmnStrokeFor(size: number | string | undefined): number | null {
  if (CMN_STROKE.policy !== 'table' || size === undefined || size === '') return null;
  const px = typeof size === 'number' ? size : parseFloat(size);
  if (!isFinite(px) || /em|%/.test(String(size))) return null;
  let w: number | null = null;
  for (const [s, weight] of CMN_STROKE.table) { if (w === null || s <= px) w = weight; }
  return w;
}

/** Final markup for one icon (shared by every component). */
export function cmnSvg(data: CmnIconData): string {
  return '<svg viewBox="' + data.viewBox + '" width="100%" height="100%" fill="none" focusable="false" aria-hidden="true">' + data.body + '</svg>';
}
",
