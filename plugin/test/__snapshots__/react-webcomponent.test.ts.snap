  "home": {"viewBox":"0 0 24 24","body":"<path d=\\"M4.123 12H20.988\\" stroke=\\"#1F1D1D\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\"/><path d=\\"M12 4V20\\" stroke=\\"#1F1D1D\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\"/>","category":"nav"},
