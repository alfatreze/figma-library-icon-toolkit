import type { CmnIconData, CmnIconDeprecatedName, CmnIconName } from './icon-data';
import { useCmnIcon } from './cmn-icon-registry';

export interface CmnIconProps extends Omit<HTMLAttributes<HTMLSpanElement>, 'color'> {
