import { CMN_LOADERS } from './loaders';

// A store: a component that subscribed ($cmnIcons) updates when a category chunk arrives.
const store = writable<ReadonlyMap<string, CmnIconData>>(new Map());
export const cmnIcons = { subscribe: store.subscribe };
const requested = new Set<string>();

/**
 * Register icons up front (synchronous, tree-shakable): registerCmnIcons(cmnHome, cmnSearch).
 * Icons you do not register are still found by name: their category loads on first use as a lazy chunk.
 */
export function registerCmnIcons(...icons: (CmnIconData | readonly CmnIconData[])[]): void {
  store.update((current) => {
    const next = new Map(current);
    for (const item of icons) for (const i of Array.isArray(item) ? item : [item as CmnIconData]) next.set(i.name, i);
    return next;
  });
}

function load(category: string): Promise<void> {
  const loader = CMN_LOADERS[category];
  if (!loader || requested.has(category)) return Promise.resolve();
  requested.add(category);
  return loader().then(
    (icons) => registerCmnIcons(icons),
    () => { requested.delete(category); } // allow a retry
  );
}

/** Warm categories ahead of use, e.g. preloadCmnIcons('arrows'). */
export function preloadCmnIcons(...categories: string[]): Promise<void[]> {
  return Promise.all(categories.map(load));
}

