};

// intentional duplicates share one drawing
const ALIASES = {};
for (const [alias, owner] of Object.entries(ALIASES)) CMN_ICONS[alias] = CMN_ICONS[owner];

export const CMN_DEPRECATED = {};
const STROKE_POLICY = 'constant';
const STROKE_TABLE = [];

const strokeFor = (size) => {
  if (STROKE_POLICY !== 'table' || !size) return null;
  const px = parseFloat(size);
  if (!isFinite(px) || /em|%/.test(size)) return null;
  let w = null;
  for (const [s, weight] of STROKE_TABLE) { if (w === null || s <= px) w = weight; }
  return w;
};

const STYLE = ':host{display:inline-block;width:var(--cmn-icon-size,1em);height:var(--cmn-icon-size,1em);flex:none;line-height:0;vertical-align:-0.125em}svg{display:block;width:100%;height:100%}';

export class CmnIconElement extends HTMLElement {
  static get observedAttributes() { return ['name', 'size', 'color', 'stroke-width', 'label']; }

  constructor() {
    super();
    this.attachShadow({ mode: 'open' });
  }

  connectedCallback() { this.#render(); }
  attributeChangedCallback() { if (this.isConnected) this.#render(); }

  /** add or replace icons at runtime: { 'my-icon': { viewBox: '0 0 24 24', body: '<path d="…"/>' } } */
  static register(icons) { Object.assign(CMN_ICONS, icons); }

  #render() {
    const requested = this.getAttribute('name') || '';
    const data = CMN_ICONS[CMN_DEPRECATED[requested] || requested];
    const size = this.getAttribute('size');
    const color = this.getAttribute('color');
    const label = this.getAttribute('label');
    const weight = this.getAttribute('stroke-width') ?? strokeFor(size);
    if (size) this.style.setProperty('--cmn-icon-size', /^[0-9.]+$/.test(size) ? size + 'px' : size); else this.style.removeProperty('--cmn-icon-size');
    if (color) this.style.setProperty('--cmn-icon-color', color); else this.style.removeProperty('--cmn-icon-color');
    if (weight !== null && weight !== undefined && weight !== '') this.style.setProperty('--cmn-icon-stroke-width', String(weight)); else this.style.removeProperty('--cmn-icon-stroke-width');
    if (label) { this.setAttribute('role', 'img'); this.setAttribute('aria-label', label); this.removeAttribute('aria-hidden'); }
    else { this.removeAttribute('role'); this.removeAttribute('aria-label'); this.setAttribute('aria-hidden', 'true'); }
    // Trusted, generated markup (not user input).
    this.shadowRoot.innerHTML = '<style>' + STYLE + '</style>' + (data
      ? '<svg viewBox="' + data.viewBox + '" fill="none" focusable="false" aria-hidden="true">' + data.body + '</svg>'
      : '');
  }
}

if (!customElements.get('cmn-icon')) customElements.define('cmn-icon', CmnIconElement);
",
}
`;

